<mujoco model="aloha_box_tranfer">
    <compiler assetdir="assets/" angle="radian"/>
    <mesh name="robot_mount" file="robot_mount.obj" inertia="shell"/>
    <texture name="robot_mount_tex" type="2d" file="robot_mount_albedotransparency.png"/>
    <texture name="robot_mount_normal" type="2d" file="robot_mount_normal.png" colorspace="linear"/>
    <material name="tex_robot_mount">
      <layer texture="robot_mount_tex" role="rgb"/>
      <layer texture="robot_mount_normal" role="normal"/>
    </material>

    <worldbody>
        <body name="robot_mount">
            <geom name="robot_mount_visual" type="mesh" mesh="robot_mount" material="tex_robot_mount" contype="0" conaffinity="0" group="2"/>
            <geom name="robot_mount_collision" type="mesh" mesh="robot_mount" contype="0" conaffinity="0" group="3"/>
        </body>
    </worldbody>
</mujoco>