<mujoco model="mat">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option cone="elliptic" impratio="10"/>

  <default>
    <default class="mat">
      <default class="visual">
        <geom group="2" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom group="3" condim="3" margin="0.001"/>
      </default>
    </default>
  </default>
  
  <worldbody>
    <body name="mat_body" childclass="mat">
      <site name="mat_site" pos="0 0 0.01"/>
      <geom type="box" class="visual" pos="0 0 0.01" size="0.12 0.12 0.01" rgba="0 0.8 0.2 1"/>
      <geom type="box" class="collision" pos="0 0 0.01" size="0.12 0.12 0.01"/>
    </body>
  </worldbody>

</mujoco>
