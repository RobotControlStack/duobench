<mujoco>
    <option integrator="implicitfast" impratio="20" noslip_iterations="5" cone="elliptic">
        <flag multiccd="enable"/>
    </option>
    <asset>
    <!-- h_block -->
   
    <mesh name="h_block1" file="join_assets/hBlock/Part Studio 1 - Part 1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="h_block2" file="join_assets/hBlock/Part Studio 1 - Part 2.stl" scale="0.001 0.001 0.001"/>
    <mesh name="h_block3" file="join_assets/hBlock/Part Studio 1 - Part 3.stl" scale="0.001 0.001 0.001"/>
    <mesh name="h_block4" file="join_assets/hBlock/Part Studio 1 - Part 4.stl" scale="0.001 0.001 0.001"/>
    <mesh name="h_block5" file="join_assets/hBlock/Part Studio 1 - Part 5.stl" scale="0.001 0.001 0.001"/>
    <mesh name="h_block6" file="join_assets/hBlock/Part Studio 1 - Part 6.stl" scale="0.001 0.001 0.001"/>
    <mesh name="h_block7" file="join_assets/hBlock/Part Studio 1 - Part 7.stl" scale="0.001 0.001 0.001"/>
    <mesh name="h_block8" file="join_assets/hBlock/Part Studio 1 - Part 8.stl" scale="0.001 0.001 0.001"/>


    <material name="black" rgba="0.15 0.15 0.15 1"/>
    </asset>

    <default>
        <default class="visual">
            <geom type="mesh" mass="0" group="1" material="black" contype="0" conaffinity="0"/>
        </default>
        <default class="collision">
            <geom group="3" type="capsule" condim="6" friction="1 5e-3 5e-4" solref=".01 1" contype="2" conaffinity="1"/>
        </default>
     </default>
    


    <worldbody>
        <body name="hblock" pos="0 0 0" euler="0 0  0">
            <joint name="hblock_joint" type="free" frictionloss="0.001" />
            <!-- inertial pos="0 0 0" mass="0.001" diaginertia="1e-1 1e-1 1e-1"/> -->
           
            <geom type="mesh" mesh="h_block1" rgba="0.3 0.3 0.3 1" group="1" contype="0" conaffinity="0"/>
            <geom  size="0.0375 0.015 0.0125"  pos="-0.055255 0.043 0.0125" class="collision" type="box" friction="3.0 0.1 0.1" solref="0.003 1"
      solimp="0.95 0.99 0.0005"
      condim="4"/>
           
            <geom type="mesh" mesh="h_block2" rgba="0.3 0.3 0.3 1" group="1" contype="0" conaffinity="0"/>
            <geom type="mesh" mesh="h_block2" class="collision"  friction="1.5 0.5 0.5" />

            <geom type="mesh" mesh="h_block3" rgba="0.3 0.3 0.3 1" group="1" contype="0" conaffinity="0"/>
            <geom type="mesh" mesh="h_block3" class="collision"  friction="1.5 0.5 0.5"  />

            <geom type="mesh" mesh="h_block4" rgba="0.3 0.3 0.3 1" group="1" contype="0" conaffinity="0"/>
            <geom type="mesh" mesh="h_block4" class="collision"  friction="1.5 0.5 0.5" />

            <geom type="mesh" mesh="h_block5" rgba="0.3 0.3 0.3 1" group="1" contype="0" conaffinity="0"/>
            <geom type="mesh" mesh="h_block5" class="collision"  friction="1.5 0.5 0.5" />

            <geom type="mesh" mesh="h_block6" rgba="0.3 0.3 0.3 1" group="1" contype="0" conaffinity="0"/>
            <geom type="mesh" mesh="h_block6" class="collision"  friction="1 0.5 0.5" />
            
            
            <!-- markers -->
            <geom type="mesh" mesh="h_block7" rgba="1 0.5 0.5 0"  name="marker_block"  friction="0 0 0" mass="0" group="2" contype="0" conaffinity="0"/>
            <geom type="mesh" mesh="h_block8" rgba="1 0.5 0.5 0"  name="marker_wall" friction="0 0 0" mass="0" group="2" contype="0" conaffinity="0"/>


        </body>
    </worldbody>
</mujoco>