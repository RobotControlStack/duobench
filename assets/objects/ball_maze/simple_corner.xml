    <mesh name="wall_base" file="task_assets/maze_assets_2/wall_plate/wall_plate - Part 1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="real_wall" file="task_assets/maze_assets_2/wall_plate/wall_plate - Part 2.stl" scale="0.001 0.001 0.001"/>

        <material name="black" rgba="0.15 0.15 0.15 1"/>
    </asset>
    <default>
        <default class="visual">
            <geom type="mesh" mass="0" group="2" material="black" contype="0" conaffinity="0"/>
        </default>
        <default class="collision">
            <geom group="3" type="capsule" condim="6" friction="1 5e-3 5e-4" solref=".01 1"/>
        </default>
     </default>
    
    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="1 0.25 0.35 1"/>
        <global azimuth="120" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
